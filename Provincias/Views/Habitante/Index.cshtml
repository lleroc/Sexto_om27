@model IEnumerable<Provincias.Models.Habitante>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
    <a class="btn btn-primary" onclick="todos()">Cargar Lista</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha_Nacimiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha_Registro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Edad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Canton)
            </th>
            <th>
                
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablahabitante">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Fecha_Nacimiento)
            </td>
            <td>
                @Html.DisplayFor(model => item.email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Fecha_Registro)
            </td>
            <td>
                @Html.DisplayFor(model => item.Edad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Canton.Nombre)
            </td>
            
            <td>
                <a class="btn btn-outline-dark"  asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a onclick="eliminar(@item.Id)" class="btn btn-outline-warning">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
